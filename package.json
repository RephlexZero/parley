{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "description": "Talk to your Claude Code sessions from a Discord voice channel",
  "type": "module",
  "engines": {
    "node": ">=24.17"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "channel": "node src/channel/server.ts",
    "hooks": "node --env-file-if-exists=.env src/cli/print-hooks.ts",
    "smoke": "node --env-file-if-exists=.env src/cli/smoke.ts",
    "stack": "node --env-file-if-exists=.env src/cli/stack.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' 'test/**/*.test.ts'",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run knip && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "discord.js": "^14.28.1",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "knip": "^6.46.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0"
  }
}
