# --- Discord (discord.com/developers → New Application → Bot) ---
DISCORD_TOKEN=
# Your user id(s), comma separated. Parley only listens to these.
DISCORD_OWNER_IDS=
# Joining this voice channel starts a call; leaving ends it.
DISCORD_VOICE_CHANNEL_ID=
# Optional: transcripts, approvals and long answers are posted here.
DISCORD_TEXT_CHANNEL_ID=

# --- Hub (local only). `npm run hooks` makes a token if this is empty. ---
PARLEY_TOKEN=
PARLEY_PORT=7420
APPROVAL_TIMEOUT_S=45

# --- Brain: cli = your logged-in Claude Code (no API key), api = Claude API ---
BRAIN=cli
# cli: haiku | sonnet | opus.  api: claude-haiku-5-5 etc.
BRAIN_MODEL=haiku
BRAIN_EFFORT=low
# Only for BRAIN=api:
# ANTHROPIC_API_KEY=

# --- Speech ---
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=
# Speech stack: eleven | local | hybrid. Switch with `npm run stack -- <name>` (src/stacks.ts).
STACK=eleven
# Overrides for one side of the stack: STT=elevenlabs|whisper, TTS=elevenlabs|kokoro
# eleven_v4_turbo reads audio tags ([laughs]); eleven_flash_v2_5 is the same price without them.
ELEVEN_TTS_MODEL=eleven_v4_turbo
ELEVEN_STT_MODEL=scribe_v3
# Speaking rate. ElevenLabs does 0.7-1.2 itself (Eleven v4 ignores it); the rest is sped up by ffmpeg
# without a pitch change.
# Kokoro 0.5-2.
TTS_SPEED=1.4
# Parallel TTS requests: ElevenLabs allows 2 on free, 3 Starter, 5 Creator.
TTS_CONCURRENCY=2
# Bias Scribe toward project/session names: +20% on STT. 0 to turn off.
STT_KEYTERMS=1
# Stream speech to Scribe v3 realtime; turn prediction ends turns (about 1 s after you stop, measured,
# vs 1.4-2.5 s for upload-after-silence). $0.22/h of streamed audio. 0 to upload utterances instead.
STT_LIVE=1
# Silence that ends a turn when turn prediction isn't sure (seconds, 0.192-3).
STT_LIVE_SILENCE_S=0.7
# Local stack (deploy/local):
# WHISPER_URL=http://127.0.0.1:8178
# KOKORO_URL=http://127.0.0.1:8880
# KOKORO_VOICE=bm_george
END_SILENCE_MS=700

# --- New background sessions ---
DISPATCH_MODEL=opus
DISPATCH_PERMISSION_MODE=auto

# --- Where projects live, and which paths count as work / uni ---
# Your name, so the assistant can use it. Leave empty for "the user".
OWNER_NAME=
PROJECT_ROOTS=~/code/personal,~/code/uni,~/code/work
WORK_MARKERS=/work/
UNI_MARKERS=/uni/
# Extra spoken names for projects, folder=name|name;folder=name
PROJECT_ALIASES=
